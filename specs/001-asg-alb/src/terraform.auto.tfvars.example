# Example variable values for ASG+ALB deployment
# Copy to terraform.tfvars and customize

# Required variables
owner  = "devops-team@example.com"
ami_id = "ami-0c55b159cbfafe1f0"  # Amazon Linux 2023 for ap-southeast-2

# Optional - override defaults as needed
# aws_region                      = "ap-southeast-2"
# environment                     = "Development"
# project_name                    = "sandbox"
# min_size                        = 1
# max_size                        = 3
# desired_capacity                = 1
# instance_type                   = "t3.micro"
# health_check_grace_period       = 300
# target_response_time_threshold  = 1.0
# scaling_target_requests         = 100
# enable_detailed_monitoring      = false
# allowed_cidr_blocks             = ["0.0.0.0/0"]
